{
    "compilerOptions": {
      "target": "ES2022",
      "useDefineForClassFields": true,
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"],
        "@core/*": ["src/core/*"],
        "@webgl/*": ["src/webgl/*"],
        "@ui/*": ["src/ui/*"]
      }
    },
    "include": ["src"]
  }